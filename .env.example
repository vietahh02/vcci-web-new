# Backend portal base URL (docker stack: portal on 8094; local `mvn spring-boot:run`: 8084)
VITE_API_BASE_URL=http://localhost:8094
# true = use the in-repo mock data layer (original prototype behaviour)
VITE_USE_MOCK=false
# Chat hỗ trợ (vcci-livestream-chat): REST + Socket.IO. Stack thử: 18096 / 18077. Để trống = widget báo chưa cấu hình
VITE_CHAT_URL=http://localhost:8096
VITE_CHAT_SOCKET_URL=http://localhost:9077
# Phòng xem trực tiếp. vcci-live-service (stack thử: 18098); để trống = cùng host với portal (nginx gom route /api/event/livestream-session)
VITE_LIVE_URL=http://localhost:8098
# Domain Jitsi, không có https://. Để trống = phòng hội thảo báo chưa cấu hình
VITE_JITSI_DOMAIN=
# Email liên hệ hiển thị ở footer và trang Trợ giúp. Để trống = ẩn (không bao giờ hiện email giả)
VITE_CONTACT_EMAIL=
