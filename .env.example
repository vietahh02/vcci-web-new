# Backend portal base URL (docker stack: portal on 8094; local `mvn spring-boot:run`: 8084)
VITE_API_BASE_URL=http://localhost:8094
# true = use the in-repo mock data layer (original prototype behaviour)
VITE_USE_MOCK=false
# Chat hỗ trợ (vcci-livestream-chat): REST + Socket.IO. Stack thử: 18096 / 18077. Để trống = widget báo chưa cấu hình
VITE_CHAT_URL=http://localhost:8096
VITE_CHAT_SOCKET_URL=http://localhost:9077
