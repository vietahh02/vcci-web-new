# Chi ap dung cho `vite build`; `vite dev` van dung .env.local.
# Khong them /api vao cuoi: moi path trong code da bat dau bang /api/...
VITE_API_BASE_URL=http://192.168.100.50:28184
VITE_USE_MOCK=false
# Chat: REST 28197, Socket.IO 28195 (hai cong khac nhau)
VITE_CHAT_URL=http://192.168.100.50:28197
VITE_CHAT_SOCKET_URL=http://192.168.100.50:28195
# Phong xem truc tiep: vcci-live-service + domain Jitsi (khong co https://)
VITE_LIVE_URL=http://192.168.100.50:28198
VITE_JITSI_DOMAIN=vcci-livestream.jarvis.com.vn
