# Chi ap dung cho `vite build`; `vite dev` van dung .env.local.
# Khong them /api vao cuoi: moi path trong code da bat dau bang /api/...
# Domain da tro sang vcci_ver2 (nginx, 2026-11-05)
VITE_API_BASE_URL=https://vcci-portal-api.jarvis.com.vn
VITE_USE_MOCK=false
# Chat: cung domain; nginx chuyen /socket.io/ sang cong Socket.IO 28195, con lai sang REST 28197
VITE_CHAT_URL=https://vcci-chat-streaming.jarvis.com.vn
VITE_CHAT_SOCKET_URL=https://vcci-chat-streaming.jarvis.com.vn
# Phong xem truc tiep: nginx chuyen /api/event/livestream-session/ cua portal-api sang vcci-live-service (28198)
VITE_LIVE_URL=https://vcci-portal-api.jarvis.com.vn
# Domain Jitsi (khong co https://)
VITE_JITSI_DOMAIN=vcci-livestream.jarvis.com.vn
# CMS: Studio phát trực tiếp của doanh nghiệp đồng tổ chức
VITE_CMS_URL=https://vcci-cms.jarvis.com.vn
